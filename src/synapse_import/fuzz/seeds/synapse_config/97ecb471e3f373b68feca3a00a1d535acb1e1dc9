# Test-only appservice registration for the import fixture: a bridge with ghost users. Nothing
# listens at its URL; Synapse and tuwunel just retry sending to it.
id: fixturebridge
url: "http://127.0.0.1:9"
as_token: "fixture-appservice-as-token-0123456789"
hs_token: "fixture-appservice-hs-token-0123456789"
sender_localpart: fixturebridge
rate_limited: false
namespaces:
  users:
    - exclusive: true
      regex: "@fixturebridge_.*:fixture.test"
  aliases:
    - exclusive: true
      regex: "#fixturebridge_.*:fixture.test"
  rooms: []
